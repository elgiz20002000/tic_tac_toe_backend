{
  "name": "tic_tac_toe_backend",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:ci": "biome ci .",
    "start:dev": "node --experimental-transform-types  --watch src/index.ts",
    "prisma-studio": "npx prisma studio --schema=src/schema.prisma",
    "reset-db": "npx prisma migrate reset --schema=src/schema.prisma",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:migrate": "docker compose exec app npx prisma migrate deploy --schema=src/schema.prisma",
    "db:seed": "npx prisma db seed --schema=src/schema.prisma"
  },
  "prisma": {
    "seed": "node --experimental-transform-types src/seeders/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.8.1",
    "cors": "^2.8.5",
    "depcheck": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.17",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "prettier": "^3.5.3",
    "prisma": "^6.8.1",
    "typescript": "^5.8.3"
  }
}

